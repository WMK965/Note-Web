server:
  host: "0.0.0.0"
  port: 8080

proxy:
  # Optional. When set, the whole app (frontend + API) is ALSO exposed under
  # this prefix, e.g. "/proxy-index" -> /proxy-index/ and /proxy-index/api/*,
  # while / and /api/* keep working as before.
  # This lets an Nginx reverse proxy publish the app on the public internet
  # without rewriting paths:
  #   location /proxy-index/ { proxy_pass http://note-web:8080; }
  #
  # Alternatively leave this empty and let Nginx strip an arbitrary public
  # prefix; the frontend derives its API prefix from the browser URL:
  #   location /notes/ { proxy_pass http://note-web:8080/; }
  base_path: ""

pdf:
  dirs:
    - /documents
  scan_interval: 300

render:
  jpeg_quality: 80
  scale_width: 1080
  thumb_width: 200

active_cache:
  render_concurrency: 3
  watch_debounce: 1h
  poll_interval: 30s

passive_cache:
  max_size_mb: 2048

database:
  path: /data/note-web.db

cache_dir: /data/cache
