# Note-Web 配置示例
#
# 时间统一写成「数字 + 单位」：s 秒、m 分、h 时、d 天，
# 支持组合与小数，例如 30s、5m、1h30m、7d、0.5h。
# 体积支持 K/M/G 后缀（1024 进制）或直接写字节数，例如 512MB、1G、2048。

server:
  host: "0.0.0.0"
  port: 8080
  # 可选。设置后整个应用（前端 + API）会额外挂载到这个前缀下，
  # 例如 "/proxy-index" -> /proxy-index/ 与 /proxy-index/api/*，
  # 同时 / 和 /api/* 照旧可用。便于 Nginx 反向代理在不改写路径的情况下
  # 把服务发布到公网：
  #   location /proxy-index/ { proxy_pass http://note-web:8080; }
  # 也可以留空，让 Nginx 自行剥掉前缀：
  #   location /notes/ { proxy_pass http://note-web:8080/; }
  proxy_path: ""

documents:
  # 文档目录列表（支持多目录），容器里对应只读挂载的 /documents
  dirs:
    - /documents
  # 目录扫描间隔
  scan_interval: 5m
  # 文件从磁盘消失后，记录与标记仍保留多久；超过后会在扫描时被真正删除
  # （含目录/标记与页面缓存）。设为 0 表示下一轮扫描立即清理。
  retention: 30d
  # 允许解析的 PDF 体积上限：GoodNotes 导入的 PDF 会原样存进归档，
  # 深度扫描需要把整份 PDF 读进内存，超过上限的附件会被跳过。
  max_file_size: 1G

cache:
  # 渲染缓存目录，容器里对应 /data/cache
  dir: /data/cache
  # 被动缓存最大占用（MB）
  max_size_mb: 2048

  # 主动缓存：已标记(pinned)的 PDF 全量预渲染
  active:
    render_concurrency: 3
    # 文件变化后等待多久再重建缓存
    watch_debounce: 1h
    # 文件变化轮询间隔
    poll_interval: 30s

  # 页面渲染参数
  render:
    jpeg_quality: 80
    # 页面短边渲染宽度；横页与竖页都会把短边缩放到该像素数
    scale_width: 1080
    thumb_width: 200

database:
  # SQLite 数据库路径，容器里对应 /data/note-web.db
  path: /data/note-web.db
  # 自动执行 VACUUM 的最小间隔，用于回收删除记录后的空闲页
  vacuum_interval: 7d
